# Fingerprinted build output can never change under the same name, so it is
# safe to keep for a year. Cloudflare otherwise sends max-age=0.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Baseline hardening for every response. No full CSP yet: Cal.com, Buy Me a
# Coffee and Google Fonts would all need allow-listing first.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
